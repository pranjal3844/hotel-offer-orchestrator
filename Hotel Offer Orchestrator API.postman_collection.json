    {
      "name": "Hotel API",
      "item": [
        {
          "name": "Delhi Hotels",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response contains 5 unique hotels\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.be.an(\"array\");\n    pm.expect(data).to.have.lengthOf(5);\n});\n\npm.test(\"Every hotel has required fields\", function () {\n    const data = pm.response.json();\n\n    data.forEach(hotel => {\n        pm.expect(hotel).to.have.property(\"name\");\n        pm.expect(hotel).to.have.property(\"price\");\n        pm.expect(hotel).to.have.property(\"supplier\");\n        pm.expect(hotel).to.have.property(\"commissionPct\");\n    });\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/hotels?city=delhi",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Price Filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Exactly 3 hotels returned\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data).to.have.lengthOf(3);\n});\n\npm.test(\"All hotels are within the price range\", function () {\n    const data = pm.response.json();\n\n    data.forEach(hotel => {\n        pm.expect(hotel.price).to.be.at.least(5000);\n        pm.expect(hotel.price).to.be.at.most(8000);\n    });\n});"
                ]
              }
            }
          ],
